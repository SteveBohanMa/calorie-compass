{
  "name": "calorie-compass-desktop",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "build:food-icons": "node scripts/build-food-icon-fallbacks.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:v25-data": "node scripts/validate-v24-data.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime && npm run build:food-icons",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "desktop:run": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@iconify-json/noto": "^1.2.7",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "build": {
    "appId": "com.caloriecompass.desktop",
    "productName": "燃卡快查",
    "artifactName": "CalorieCompass-v2.5-portable.exe",
    "compression": "maximum",
    "directories": {
      "output": "release-v2.5"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/client",
        "to": "app"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
